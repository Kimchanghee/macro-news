---
import Base from '../../layouts/Base.astro';
import site from '../../site.config';
import { getCollection } from 'astro:content';
import { longDate, fitText } from '../../lib/calc.mjs';
const guides = (await getCollection('guides')).filter((g) => g.data.status === 'published').sort((a, b) => a.data.title.localeCompare(b.data.title));
const title = 'Guides to Reading U.S. and Euro Area Economic Data Releases';
const description = fitText('Plain-English guides to CPI, core inflation, the jobs report, wage data, revisions, the yield curve, FOMC and ECB decisions, each sourced to the agency.', ['Dated.']);
const ld = [{ '@context': 'https://schema.org', '@type': 'CollectionPage', name: title, description, url: `${site.url}/guides/`, isPartOf: { '@id': `${site.url}/#website` }, hasPart: guides.map((g) => ({ '@type': 'Article', headline: g.data.title, url: `${site.url}/guides/${g.id}/` })) }];
---
<Base title={title} description={description} path="/guides/" jsonld={ld} crumbs={[{ name: 'Guides', path: '/guides/' }]} ogImage="/og/guides.png">
  <div class="page">
    <header class="doc-head">
      <p class="kicker">Section IV · Guides</p>
      <h1>How do you read an economic data release?</h1>
      <p class="lede" id="answer">Start with what the statistic measures, the reference period, and whether the figure is seasonally adjusted or preliminary; then compare it with the prior month and year. These {guides.length} guides walk through each release we track, sourced to BLS, Treasury, Eurostat, the Fed and the ECB.</p>
      <p class="meta">Subscribe via the <a href="/feed.xml">RSS feed</a>.</p>
    </header>
    <ul class="toc-list">
      {guides.map((g) => <li><span class="d">Updated {longDate(g.data.updated.toISOString())}</span><div><a href={`/guides/${g.id}/`}>{g.data.title}</a><p>{g.data.answer}</p></div></li>)}
    </ul>
  </div>
</Base>
